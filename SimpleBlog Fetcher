<!DOCTYPE html>
<html>
<head>
  <title>Mini Blog</title>
</head>
<body>
  <div>
    <h2>Mini Blog</h2>
    <div id="posts"></div>
    <button id="loadMoreBtn">Load More</button>
    <p id="status"></p>
  </div>

  <script>
    var postsContainer = document.getElementById('posts');
    var loadMoreBtn = document.getElementById('loadMoreBtn');
    var statusEl = document.getElementById('status');
    var currentPage = 1;
    var limit = 5;

    function fetchPosts(currentPage, limit) {
      statusEl.textContent = "Loading...";

      fetch('https://jsonplaceholder.typicode.com/posts?_page=' + currentPage + '&_limit=' + limit)
        .then(function(response) {
          return response.json();
        })
        .then(function(data) {
          statusEl.textContent = "";

          data.forEach(function(post) {
            var postDiv = document.createElement('div');
            postDiv.style.border = "1px solid #ccc";
            postDiv.style.margin = "10px 0";
            postDiv.style.padding = "10px";

            var title = document.createElement('h3');
            title.textContent = post.title;

            var body = document.createElement('p');
            body.textContent = post.body;

            postDiv.appendChild(title);
            postDiv.appendChild(body);
            postsContainer.appendChild(postDiv);
          });
        })
        .catch(function() {
          statusEl.textContent = "Error fetching posts!";
        });
    }

    loadMoreBtn.addEventListener('click', function() {
      fetchPosts(currentPage, limit);
      currentPage++;
    });
    fetchPosts(currentPage, limit);
    currentPage++;
  </script>
</body>
</html>
